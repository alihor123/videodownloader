@startuml
!pragma layout elk
allowmixing
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam packageStyle rectangle
skinparam nodesep 85
skinparam ranksep 100
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam rectangleBackgroundColor #EAF3FC
skinparam classBackgroundColor #FFF2D6
hide empty members
hide circle
title Данные входящих запросов — media/schemas.py

package "media/schemas.py" as OWN {
  class "InfoRequest\n<size:12>Запрос информации о видео</size>" as C_InfoRequest {
    url : str
    task_id : UUID | None
  }
  class "DownloadFormat\n<size:12>Параметры скачивания</size>" as C_DownloadFormat {
    height : int
    fast : bool
    kind : Literal['video', 'audio']
  }
  class "DownloadRequest\n<size:12>Запрос скачивания</size>" as C_DownloadRequest {
    format : DownloadFormat
  }
}


C_DownloadRequest --> C_DownloadFormat : format
C_DownloadRequest --|> C_InfoRequest
@enduml
