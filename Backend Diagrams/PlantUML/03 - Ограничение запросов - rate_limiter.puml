@startuml
!pragma layout elk
allowmixing
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam packageStyle rectangle
skinparam nodesep 85
skinparam ranksep 100
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam rectangleBackgroundColor #EAF3FC
skinparam classBackgroundColor #FFF2D6
hide empty members
hide circle
title Ограничение запросов — rate_limiter.py

package "rate_limiter.py" as OWN {
  rectangle "get_client_ip()\nОпределение IP клиента" as F_get_client_ip
  class "RateLimiter\n<size:12>Лимит запросов по IP</size>" as C_RateLimiter {
    max_clients : int {static}
    max_requests : int
    period : int
    history : OrderedDict[str, deque[float]]
  }
}

class "Settings\n(config.py)" as C_Settings #F2F4F7

C_RateLimiter ..> F_get_client_ip
F_get_client_ip ..> C_Settings
@enduml
