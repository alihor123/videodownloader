@startuml
!pragma layout elk
allowmixing
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam packageStyle rectangle
skinparam nodesep 85
skinparam ranksep 100
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam rectangleBackgroundColor #EAF3FC
skinparam classBackgroundColor #FFF2D6
hide empty members
hide circle
title Выбор исходящего IP — proxies/pool.py

package "proxies/pool.py" as OWN {
  rectangle "configure()\nНастройка пула прокси" as F_configure
  rectangle "restore_cooled_down()\nВозврат IP после ожидания" as F_restore_cooled_down
  rectangle "start_new_round()\nНовый круг выбора IP" as F_start_new_round
  rectangle "get_proxy_key()\nВыбор следующего IP" as F_get_proxy_key
  rectangle "get_proxy_url()\nURL выбранного прокси" as F_get_proxy_url
  rectangle "get_proxy_endpoint()\nАдрес прокси без пароля" as F_get_proxy_endpoint
  rectangle "put_on_cooldown()\nВременное исключение IP" as F_put_on_cooldown
  rectangle "max_proxy_attempts()\nЧисло доступных исходящих IP" as F_max_proxy_attempts
}

class "Settings\n(config.py)" as C_Settings #F2F4F7

F_configure ..> C_Settings
F_configure ..> F_start_new_round
F_get_proxy_endpoint ..> F_get_proxy_url
F_get_proxy_key ..> F_restore_cooled_down
F_get_proxy_key ..> F_start_new_round
F_put_on_cooldown ..> C_Settings
F_start_new_round ..> F_restore_cooled_down
@enduml
