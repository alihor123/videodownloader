@startuml
!pragma layout elk
allowmixing
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam packageStyle rectangle
skinparam nodesep 85
skinparam ranksep 100
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam rectangleBackgroundColor #EAF3FC
skinparam classBackgroundColor #FFF2D6
hide empty members
hide circle
title Настройки и запуск yt-dlp — media/ytdlp.py

package "media/ytdlp.py" as OWN {
  rectangle "get_info_ydl_opts()\nНастройки получения метаданных" as F_get_info_ydl_opts
  rectangle "get_download_ydl_opts()\nНастройки скачивания yt-dlp" as F_get_download_ydl_opts
  rectangle "get_video_url()\nУдаление playlist из ссылки" as F_get_video_url
  rectangle "extract_info()\nВызов yt-dlp" as F_extract_info
}

class "Settings\n(config.py)" as C_Settings #F2F4F7
rectangle "get_download_format()\nСелектор форматов yt-dlp\n(media/formats.py)" as F_get_download_format #F2F4F7

F_extract_info ..> F_get_video_url
F_get_download_ydl_opts ..> C_Settings
F_get_download_ydl_opts ..> F_get_download_format
@enduml
