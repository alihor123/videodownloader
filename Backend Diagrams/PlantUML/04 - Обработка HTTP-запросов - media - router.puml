class "Settings\n(config.py)" as C_Settings #F2F4F7
rectangle "add_download_stat()\nЗапись успешной передачи\n(media/statistics.py)" as F_add_download_stat #F2F4F7
rectangle "add_proxy_download_success()\nУчёт успешного скачивания\n(proxies/statistics.py)" as F_add_proxy_download_success #F2F4F7
rectangle "build_content_disposition()\nЗаголовок имени файла\n(media/formats.py)" as F_build_content_disposition #F2F4F7
rectangle "cancel_task()\nОтмена и ожидание остановки\n(media/tasks.py)" as F_cancel_task #F2F4F7
rectangle "cleanup_directory()\nУдаление папки задачи\n(media/tasks.py)" as F_cleanup_directory #F2F4F7
rectangle "create_task()\nСоздание задачи в очереди\n(media/tasks.py)" as F_create_task #F2F4F7
rectangle "detect_platform()\nОпределение видеоплатформы\n(media/platforms.py)" as F_detect_platform #F2F4F7
