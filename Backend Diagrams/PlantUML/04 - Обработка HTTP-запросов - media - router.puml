@startuml
skinparam linetype ortho
allowmixing
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam packageStyle rectangle
skinparam nodesep 85
skinparam ranksep 100
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam rectangleBackgroundColor #EAF3FC
skinparam classBackgroundColor #FFF2D6
hide empty members
hide circle
title Обработка HTTP-запросов — media/router.py

  rectangle "validate_url()\nПроверка входящей ссылки" as F_validate_url
  rectangle "get_info()\nЗапрос информации о видео" as F_get_info
  rectangle "create_download()\nЗапрос создания скачивания" as F_create_download
  rectangle "status()\nЗапрос состояния задачи" as F_status
  rectangle "cancel()\nЗапрос отмены задачи" as F_cancel
  class "ManagedFileResponse\n<size:12>Передача готового файла</size>" as C_ManagedFileResponse {
    task : MediaTask
    finished : bool
  }
  class "ManagedFastResponse\n<size:12>Передача прямого потока</size>" as C_ManagedFastResponse {
    task : MediaTask
    finished : bool
  }
  rectangle "download()\nВыдача файла или потока" as F_download

class "DownloadRequest\n(media/schemas.py)" as C_DownloadRequest #F2F4F7
class "InfoRequest\n(media/schemas.py)" as C_InfoRequest #F2F4F7
class "MediaTask\n(media/tasks.py)" as C_MediaTask #F2F4F7
