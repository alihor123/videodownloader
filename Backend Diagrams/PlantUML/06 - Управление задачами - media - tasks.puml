@startuml
skinparam linetype ortho
allowmixing
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam packageStyle rectangle
skinparam nodesep 85
skinparam ranksep 100
skinparam ArrowColor #34495E
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam rectangleBackgroundColor #EAF3FC
skinparam classBackgroundColor #FFF2D6
hide empty members
hide circle
title Управление задачами — media/tasks.py

  class "MediaTask\n<size:12>Состояние операции</size>" as C_MediaTask {
    id : str
    url : str
    mode : str
    requested_fast : bool
    delivery_mode : str
    format_kind : str
    height : str
    platform : str
    status : str
    stage : str
    progress : int | None
    error : str | None
    result : dict | None
    created : float
    touched : float
    ready_at : float | None
    cancel : asyncio.Event
    runner : asyncio.Task | None
    streaming : bool
    transfer_done : asyncio.Event
    ip : str
    user_agent : str | None
    queue_name : str
    fallback_requested : bool
    proxy_key : str | None
    proxy_attempts : int
    retry_with_another_proxy : bool
    proxy_error_kind : str | None
    /directory : Path
  }
  rectangle "normalize_id()\nПроверка и нормализация UUID" as F_normalize_id
  rectangle "cleanup_directory()\nУдаление папки задачи" as F_cleanup_directory
  rectangle "get_task()\nПоиск задачи по UUID" as F_get_task
  rectangle "serialize_task()\nСостояние задачи для API" as F_serialize_task
  rectangle "queue_position()\nПозиция задачи в очереди" as F_queue_position
  rectangle "ensure_queues()\nСоздание очередей" as F_ensure_queues
  rectangle "create_task()\nСоздание задачи в очереди" as F_create_task
  rectangle "cancel_task()\nОтмена и ожидание остановки" as F_cancel_task
  rectangle "read_events()\nЧтение событий worker" as F_read_events
  rectangle "drain_errors()\nЗапись stderr worker в лог" as F_drain_errors
  rectangle "queue_worker()\nОбработка очереди задач" as F_queue_worker
  rectangle "run_task()\nУправление процессом worker" as F_run_task
  rectangle "reap_tasks()\nПроверка лимитов и очистка" as F_reap_tasks
  rectangle "start_tasks()\nЗапуск очередей и очистки" as F_start_tasks
  rectangle "shutdown_tasks()\nОстановка всех задач" as F_shutdown_tasks

class "Settings\n(config.py)" as C_Settings #F2F4F7
class "WindowsJob\n(process_tree.py)" as C_WindowsJob #F2F4F7
rectangle "add_proxy_info_success()\nУчёт успешных метаданных\n(proxies/statistics.py)" as F_add_proxy_info_success #F2F4F7
rectangle "add_proxy_ip_error()\nУчёт ошибки исходящего IP\n(proxies/statistics.py)" as F_add_proxy_ip_error #F2F4F7
rectangle "detect_platform()\nОпределение видеоплатформы\n(media/platforms.py)" as F_detect_platform #F2F4F7
rectangle "get_proxy_key()\nВыбор следующего IP\n(proxies/pool.py)" as F_get_proxy_key #F2F4F7
rectangle "get_proxy_url()\nURL выбранного прокси\n(proxies/pool.py)" as F_get_proxy_url #F2F4F7
rectangle "get_stage_message()\nТекст этапа для клиента\n(media/messages.py)" as F_get_stage_message #F2F4F7
rectangle "max_proxy_attempts()\nЧисло доступных исходящих IP\n(proxies/pool.py)" as F_max_proxy_attempts #F2F4F7
rectangle "put_on_cooldown()\nВременное исключение IP\n(proxies/pool.py)" as F_put_on_cooldown #F2F4F7
rectangle "stop_process_tree()\nОстановка worker и потомков\n(process_tree.py)" as F_stop_process_tree #F2F4F7
component "media/worker.py\nОтдельный процесс" as P_media_worker_py #F2F4F7

