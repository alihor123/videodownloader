F_cleanup_directory -[hidden]down-> C_WindowsJob
C_WindowsJob -[hidden]down-> F_add_proxy_info_success
F_add_proxy_info_success -[hidden]down-> F_put_on_cooldown
F_get_task -[dashed,norank]-> C_MediaTask
F_queue_worker -[dashed,norank]-> C_MediaTask
F_reap_tasks -[dashed,norank]-> C_MediaTask
F_shutdown_tasks -[dashed,norank]-> C_MediaTask
