DATABASE_NAME=stats.db
FFMPEG_PATH=bin/ffmpeg.exe
YOUTUBE_COOKIES_FILE=cookies/youtube.txt
RUTUBE_COOKIES_FILE=cookies/rutube.txt
VK_COOKIES_FILE=cookies/vk.txt
TWITTER_COOKIES_FILE=cookies/twitter.txt
TIKTOK_COOKIES_FILE=cookies/tiktok.txt
INSTAGRAM_COOKIES_FILE=cookies/instagram.txt
ENABLE_DOCS=false
TRUST_PROXY_HEADERS=false
INFO_RATE_LIMIT_REQUESTS=20
INFO_RATE_LIMIT_PERIOD_SEC=60
FILE_DOWNLOAD_RATE_LIMIT_REQUESTS=10
FILE_DOWNLOAD_RATE_LIMIT_PERIOD_SEC=3600
FAST_DOWNLOAD_RATE_LIMIT_REQUESTS=10
FAST_DOWNLOAD_RATE_LIMIT_PERIOD_SEC=3600
INFO_QUEUE_SIZE=20
FAST_QUEUE_SIZE=20
FILE_QUEUE_SIZE=50
INFO_WORKER_COUNT=1
FAST_WORKER_COUNT=4
FILE_WORKER_COUNT=3
MAX_QUEUE_TOTAL=100
MAX_QUEUE_PER_IP=10
TEMP_FILE_MAX_AGE_SEC=5400
MEDIA_CLIENT_TIMEOUT_SEC=90
MEDIA_INFO_TIMEOUT_SEC=100
MEDIA_TASK_TIMEOUT_SEC=900
MEDIA_READY_TIMEOUT_SEC=120
MEDIA_MAX_BYTES=2147483648
MAX_RETAINED_MEDIA_TASKS=1000

# GitHub webhook автодеплоя. На локальной машине оставьте выключенным.
DEPLOY_ENABLED=false
DEPLOY_WEBHOOK_SECRET=
DEPLOY_BRANCH=update
DEPLOY_REPOSITORY_URL=https://github.com/alihor123/videodownloader.git
DEPLOY_REPOSITORY_DIR=../.deploy/repository
DEPLOY_WORK_DIR=../.deploy/work
DEPLOY_RELEASE_DIR=..
DEPLOY_FRONTEND_DIR=../front/dist
DEPLOY_PYTHON_PATH=venv/Scripts/python.exe
DEPLOY_BACKEND_SERVICE=videodownloader-backend.service
